# ELUM Browse talks to the ELUM platform on Supabase: the same project as Write, Type, Make and
# ELUM Account. Netlify builds refuse to run without these.
VITE_SUPABASE_URL=https://afdnnvngrpdodsfwpaqo.supabase.co
# The publishable (anon) key. Safe in the browser.
VITE_SUPABASE_ANON_KEY=

# Where Browse itself lives, for /opensearch.xml (add Browse as a search engine).
# VITE_ELUM_BROWSE_URL=https://elumbrowse.netlify.app
# ELUM Account and the other apps (these are the defaults).
# VITE_ELUM_ACCOUNT_URL=https://elumaccounts.netlify.app
# VITE_ELUM_WRITE_URL=https://elumwrite.netlify.app
# VITE_ELUM_TYPE_URL=https://elumtype.netlify.app
# VITE_ELUM_MAKE_URL=https://elummake.netlify.app

# The Google key is NOT set here: it lives on the server, as Supabase secrets for the
# browse-search function (GOOGLE_SEARCH_KEY, GOOGLE_SEARCH_CX). See README.md.
