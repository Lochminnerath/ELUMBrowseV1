# ELUM Browse talks to the ELUM platform on Supabase: the same project as Write, Type, Make and
# ELUM Account. Netlify builds refuse to run without these.
VITE_SUPABASE_URL=https://afdnnvngrpdodsfwpaqo.supabase.co
# The publishable (anon) key. Safe in the browser.
VITE_SUPABASE_ANON_KEY=

# Where Browse itself lives, for /opensearch.xml (add Browse as a search engine).
# VITE_ELUM_BROWSE_URL=https://browsebyelum.netlify.app
# ELUM Account and the other apps (these are the defaults).
# VITE_ELUM_ACCOUNT_URL=https://accountsbyelum.netlify.app
# VITE_ELUM_WRITE_URL=https://writebyelum.netlify.app
# VITE_ELUM_TYPE_URL=https://typebyelum.netlify.app
# VITE_ELUM_MAKE_URL=https://makebyelum.netlify.app

# Google results come from the Programmable Search Element with this engine (the default).
# The engine ID is public. Set it empty to use the browse-search function instead, whose Google
# key lives on the server as Supabase secrets (GOOGLE_SEARCH_KEY, GOOGLE_SEARCH_CX). See README.md.
# VITE_GOOGLE_CSE_ID=61de32450a25e4731
